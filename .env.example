# Path to the YAML policy file this issuer evaluates payments against.
VERIGATE_POLICY=policies/default.yaml

# Path to the SQLite audit-log database.
VERIGATE_DB=data/verigate.db

# Ed25519 keypair used to sign decisions. Generated automatically on first
# run if missing — in production, generate once and back up the private
# key; never commit it to git.
VERIGATE_PRIVATE_KEY=keys/issuer.key
VERIGATE_PUBLIC_KEY=keys/issuer.pub

# Arc Mainnet Authority Registry. Defaults below match the currently deployed
# Verigate Registry; change them only when intentionally targeting another deployment.
VERIGATE_ARC_RPC_URL=https://rpc.mainnet.arc.io
VERIGATE_ARC_REGISTRY_ADDRESS=0x4D09CdD490c1Ce48BCB6dA5c1A6Bf41E2f5e853D
# Must be the Registry owner or an issuer previously enabled by the owner.
VERIGATE_ARC_ISSUER_ADDRESS=0x1429906b663608DB6aDeAb8F975B47aFbbe8c68C
# Recovered and read-only verified deployed runtime hash; the API fails closed on mismatch.
VERIGATE_ARC_REGISTRY_CODE_HASH=0x6b229c049b9ba0007c318a10759a9827b5a798a4e511611872dcd4cf3973b160
