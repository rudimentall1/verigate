{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "bundled:verigate-authority",
      "min_version": "0.1.1",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "tags": ["verigate-authority"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Verigate Authority",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 420, "h": 360 },
        "default_size": { "w": 620, "h": 520 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:bundled:verigate-authority"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
