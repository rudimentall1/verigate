{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "bundled:verigate-authority",
      "min_version": "0.1.3",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "Verigate Authority checks a user-described payment or transfer against deterministic policy rules. Use Anna AI to extract user-provided fields and explain the final decision in plain language. The AI must never choose or override ALLOW/WARN/BLOCK; that decision comes from the Verigate tool. Never claim a transaction was executed.",
  "tags": ["security", "agent-authority", "payments", "policy", "proof"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Verigate Authority",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 460, "h": 660 },
        "default_size": { "w": 640, "h": 820 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "llm": ["complete"],
      "tools": ["required:bundled:verigate-authority"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
