{
  "slug": "verigate-authority",
  "name": "verigate-authority",
  "version": "0.1.2",
  "executa_type": "tool",
  "description": "Wraps Verigate's GuardrailEngine.authorize() as a single verigate_check tool: give it an agent action, get back a signed ALLOW/WARN/BLOCK authority decision, independently verifiable without trusting this Executa or Verigate's own server.",
  "tool_id": "tool-dev-verigate-authority",
  "type": "python",
  "distribution": {
    "active": "binary",
    "profiles": {
      "local": {
        "type": "local",
        "supports_protocol": true
      },
      "binary": {
        "type": "binary",
        "supports_protocol": true,
        "binary_artifacts": {
          "darwin-arm64": {
            "path": "dist/verigate-authority-{version}-darwin-arm64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "darwin-x86_64": {
            "path": "dist/verigate-authority-{version}-darwin-x86_64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "linux-x86_64": {
            "path": "dist/verigate-authority-{version}-linux-x86_64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "windows-x86_64": {
            "path": "dist/verigate-authority-{version}-windows-x86_64.zip",
            "entrypoint": "verigate-authority.exe",
            "format": "zip"
          }
        }
      }
    }
  }
}
