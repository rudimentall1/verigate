{
  "slug": "verigate-authority",
  "name": "verigate-authority",
  "version": "0.1.8",
  "executa_type": "tool",
  "description": "Evaluates agent actions against Verigate deterministic policy rules and returns a signed ALLOW/WARN/BLOCK decision. It does not sign, submit, broadcast, or execute a blockchain transaction.",
  "tool_id": "tool-dev-verigate-authority",
  "type": "python",
  "distribution": {
    "active": "binary",
    "profiles": {
      "local": {
        "type": "local",
        "supports_protocol": true
      },
      "binary": {
        "type": "binary",
        "supports_protocol": true,
        "binary_artifacts": {
          "darwin-arm64": {
            "path": "dist/verigate-authority-{version}-darwin-arm64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "darwin-x86_64": {
            "path": "dist/verigate-authority-{version}-darwin-x86_64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "linux-x86_64": {
            "path": "dist/verigate-authority-{version}-linux-x86_64.tar.gz",
            "entrypoint": "verigate-authority",
            "format": "tar.gz"
          },
          "windows-x86_64": {
            "path": "dist/verigate-authority-{version}-windows-x86_64.zip",
            "entrypoint": "verigate-authority.exe",
            "format": "zip"
          }
        }
      }
    }
  }
}
