# Copy to /etc/verigate-signer/issuer.env, replace every placeholder,
# then chown root:root and chmod 0640. No EVM private key belongs here.
VERIGATE_SIGNER_SOCKET=/run/verigate-signer-issuer/signer.sock
VERIGATE_SIGNER_JOURNAL=/var/lib/verigate-signer-issuer/ops.jsonl
VERIGATE_SIGNER_PRIVATE_KEY_FILE=/etc/verigate-signer/keys/issuer.key
VERIGATE_AUTH_PUBLIC_KEY_FILE=/etc/verigate-signer/keys/issuer-authorization-public.pem
VERIGATE_ARC_RPC_URL=https://REPLACE_WITH_TRUSTED_ARC_MAINNET_RPC
VERIGATE_ARC_ISSUER_ADDRESS=0xREPLACE_WITH_ENABLED_REGISTRY_ISSUER
VERIGATE_ARC_REGISTRY_ADDRESS=0x4D09CdD490c1Ce48BCB6DA5c1A6Bf41E2f5e853D
VERIGATE_ARC_REGISTRY_CODE_HASH=0x6b229c049b9ba0007c318a10759a9827b5a798a4e511611872dcd4cf3973b160
# Measure these against representative Arc receipts; do not copy guessed limits.
VERIGATE_SIGNER_GAS_LIMIT=REPLACE_WITH_MEASURED_POSITIVE_INTEGER
VERIGATE_SIGNER_MAX_FEE_PER_GAS=REPLACE_WITH_MEASURED_POSITIVE_INTEGER
VERIGATE_SIGNER_MAX_PRIORITY_FEE_PER_GAS=REPLACE_WITH_MEASURED_POSITIVE_INTEGER
VERIGATE_SIGNER_MAX_NATIVE_COST=REPLACE_WITH_REVIEWED_WEI_CEILING
VERIGATE_SIGNER_DAILY_NATIVE_BUDGET=REPLACE_WITH_REVIEWED_WEI_BUDGET
VERIGATE_SIGNER_CONFIRMATIONS=1
